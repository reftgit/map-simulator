; Istanbul Halic — Godot 4 environment demo
config_version=5

[application]
config/name="İstanbul • Haliç"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/description="OSM tabanlı, stilize İstanbul çevresi. © OpenStreetMap contributors."
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/ios/allow_high_refresh_rate.perf_60hz=false

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
punch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}
roll={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
vehicle_throttle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
vehicle_brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
vehicle_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
vehicle_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
vehicle_handbrake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[input_devices]
pointing/emulate_touch_from_mouse=true

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hurtbox"
3d_physics/layer_4="vehicle"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.63, 0.76, 0.79, 1)

[physics]
3d/physics_engine.perf_jolt="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
