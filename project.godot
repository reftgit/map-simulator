; Istanbul Halic — Godot 4 environment demo
config_version=5

[application]
config/name="İstanbul • Haliç"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="OSM tabanlı, stilize İstanbul çevresi. © OpenStreetMap contributors."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.63, 0.76, 0.79, 1)

[physics]
common/physics_ticks_per_second=60
