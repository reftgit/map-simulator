# Godot editor cache and imported assets (regenerated on import)
.godot/

# Map model kept out of Git (502 MB, over GitHub's 100 MB limit).
# Source location and SHA-256: docs/maps/istanbul_halic/README.md
/assets/istanbul_halic.glb
# The cells map's GLB is generated on each machine (same README, "The cells map").
/assets/istanbul_halic_cells.glb
# The experimental facade variants of the cells map, generated the same way.
/assets/istanbul_halic_cells_light.glb
/assets/istanbul_halic_cells_shader.glb

# Export output and platform build templates. build/.gdignore is tracked so
# Godot never scans or packs build output (e.g. Xcode's CgBI PNGs).
/build/*
!/build/.gdignore
/android/

# Map generator output (default --out of tools/maps/istanbul_halic/build_map.py).
# Already inside /build/*; listed so it stays ignored if that rule changes.
/build/maps/

# Python bytecode caches of the map generator
__pycache__/

# OS files
.DS_Store
