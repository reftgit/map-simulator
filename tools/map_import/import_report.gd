extends RefCounted
## The import tool's report (docs/maps/imported/<id>.md): the contract checks
## (docs/MAP_CONTRACT.md) with their results, the fixes, the categories, the
## colliders and occluders, the placement, the timings, and the files written.


## Markdown for one import. `info` holds: id, source (file name), bytes,
## sha256, config (Dictionary), command, outputs ([path, bytes, in_git]),
## placement (Dictionary, optional), seconds, written (bool).
static func markdown(importer: RefCounted, info: Dictionary) -> String:
	var lines := PackedStringArray()
	lines.append("# Import report: %s" % info.id)
	lines.append("")
	lines.append("Generated by `tools/import_map.gd` on %s (Godot %s). Rules: `docs/MAP_CONTRACT.md`." % [Time.get_date_string_from_system(), Engine.get_version_info().string])
	lines.append("")
	lines.append("| | |")
	lines.append("|---|---|")
	lines.append("| Source | `%s`, %s bytes, SHA-256 `%s` |" % [info.source, _thousands(info.bytes), info.sha256])
	lines.append("| Command | `%s` |" % info.command)
	lines.append("| Configuration | %s |" % ("`%s`" % JSON.stringify(info.config) if not info.config.is_empty() else "none"))
	lines.append("| Result | %s |" % ("map written" + (" and registered" if info.get("registered", false) else "") if info.written else "**not written**: a mandatory check failed (below)"))
	lines.append("| Tool run | %.1f s |" % info.seconds)
	lines.append("")
	lines.append("## Contract checks")
	lines.append("")
	lines.append("| Rule | Result | Details |")
	lines.append("|---|---|---|")
	for check: Dictionary in importer.checks:
		lines.append("| %s | %s | %s |" % [check.id, ("**%s**" % check.result) if check.result in ["FAIL", "WARN"] else check.result, check.message.replace("|", "\\|")])
	var summary: Dictionary = importer.summary
	if summary.has("triangles"):
		lines.append("")
		lines.append("## Model")
		lines.append("")
		var bounds: AABB = summary.bounds
		lines.append("- %d mesh nodes, %d meshes, %s triangles, %d materials" % [summary.get("mesh_nodes", 0), summary.get("meshes", 0), _thousands(summary.triangles), summary.get("materials", 0)])
		lines.append("- Bounds: x %.1f … %.1f, y %.1f … %.1f, z %.1f … %.1f m" % [bounds.position.x, bounds.end.x, bounds.position.y, bounds.end.y, bounds.position.z, bounds.end.z])
		lines.append("- 90th-percentile mesh height: %.2f m" % summary.p90_height)
	if not importer.meshes.is_empty() and summary.has("classified_by"):
		lines.append("")
		lines.append("## Categories")
		lines.append("")
		lines.append("| Category | Meshes | Triangles | By configured rule | By vocabulary | By shape | Default |")
		lines.append("|---|---|---|---|---|---|---|")
		var table := {}
		for record: Dictionary in importer.meshes.values():
			var key: String = record.category if not record.category.is_empty() else "(none)"
			if not table.has(key):
				table[key] = {"meshes": 0, "triangles": 0, "rule": 0, "vocabulary": 0, "shape": 0, "default": 0, "none": 0}
			table[key].meshes += 1
			table[key].triangles += record.triangles
			table[key][record.by] += 1
		var keys := table.keys()
		keys.sort()
		for key: String in keys:
			var row: Dictionary = table[key]
			lines.append("| %s | %d | %s | %d | %d | %d | %d |" % [key, row.meshes, _thousands(row.triangles), row.rule, row.vocabulary, row.shape, row.default])
		lines.append("")
		lines.append("The map's category rules (`%s_categories.tres`): %d configured rules, %d vocabulary lines, then one group rule per category for the meshes classified by shape." % [info.id,
				summary.rule_counts.configured, summary.rule_counts.vocabulary])
	if summary.has("colliders"):
		lines.append("")
		lines.append("## Colliders and occluders")
		lines.append("")
		var colliders: Dictionary = summary.colliders
		lines.append("- Colliders: %d static bodies, %d shapes %s, %s trimesh triangles; %d parts skipped (too small or flat)" % [colliders.bodies, colliders.shapes, JSON.stringify(summary.get("collider_types", {})), _thousands(colliders.trimesh_triangles), colliders.skipped])
		if summary.has("occluders"):
			lines.append("- Occluders (from the %s colliders): %d, %s triangles" % [" and ".join(PackedStringArray(importer.rules.occluder_categories)), summary.occluders, _thousands(summary.occluder_triangles)])
		if summary.has("shells"):
			var shells: Dictionary = summary.shells
			lines.append("- Building shells: %d building meshes, %d checked, %d open; %d closed meshes (any category) turned outward; %d zero-area triangles; %d triangles disagree with their normals" % [shells.buildings, shells.checked, shells.open, shells.inside_out, summary.zero_area, summary.flipped])
	if info.has("placement") and not (info.placement as Dictionary).is_empty():
		lines.append("")
		lines.append("## Placement")
		lines.append("")
		for line: String in info.placement.get("lines", []):
			lines.append("- " + line)
	lines.append("")
	lines.append("## Timings")
	lines.append("")
	var stages := PackedStringArray()
	for stage in importer.timings:
		stages.append("%s %.1f s" % [stage, importer.timings[stage] / 1000.0])
	lines.append(", ".join(stages))
	if not info.get("outputs", []).is_empty():
		lines.append("")
		lines.append("## Files")
		lines.append("")
		lines.append("| File | Bytes | In Git |")
		lines.append("|---|---|---|")
		for output: Array in info.outputs:
			lines.append("| `%s` | %s | %s |" % [output[0], _thousands(output[1]), "yes" if output[2] else "no (regenerate with the command above)"])
	lines.append("")
	return "\n".join(lines)



static func _thousands(value: int) -> String:
	var text := str(absi(value))
	var out := ""
	while text.length() > 3:
		out = "," + text.substr(text.length() - 3) + out
		text = text.substr(0, text.length() - 3)
	return ("-" if value < 0 else "") + text + out
